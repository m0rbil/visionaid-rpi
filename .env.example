# Copy this file to .env and fill in your own keys.
# .env is gitignored - never put real keys in this template or in the code.
#
# Gemini : https://aistudio.google.com/apikey
# TTS    : https://console.cloud.google.com/apis/credentials
#          (the Cloud Text-to-Speech API must be enabled)

GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_TTS_API_KEY=your_google_tts_api_key_here

# Output language: tr or en. Defaults to tr.
VISIONAID_LANG=tr
