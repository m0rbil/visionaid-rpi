# VisionAid - Ortam Değişkenleri Şablonu
# -----------------------------------------------
# Kurulum:
#   1. Bu dosyayı ".env" adıyla kopyala
#   2. Aşağıdaki değerleri kendi anahtarlarınla değiştir
#
# .env dosyası .gitignore içinde olduğu için GitHub'a gönderilmez.
# Anahtarlarını asla bu şablona veya koda yazma.
#
# Anahtar almak için:
#   Gemini : https://aistudio.google.com/apikey
#   TTS    : https://console.cloud.google.com/apis/credentials
#            (Cloud Text-to-Speech API'nin etkin olması gerekir)

GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_TTS_API_KEY=your_google_tts_api_key_here
